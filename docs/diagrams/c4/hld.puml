@startuml
!include <C4/C4_Component>

'LAYOUT_LEFT_RIGHT()
LAYOUT_WITH_LEGEND()

' title Верхнеуровневая архитектура системы обработки ошибок

!include components/c4/ext/observability.iuml
!include components/c4/ext/user.iuml
!include components/c4/ext/developer.iuml

Container_Boundary(project, "Конкретный проект") {
  !include components/c4/app.iuml
  !include components/c4/app_error_handler.iuml
}

Boundary(go_core, "Библиотека go-core") {
  !include components/c4/errors.iuml
  !include components/c4/wire_errors.iuml
}

Rel(app, errors, "Определяет в каждом слое свои ошибки на основе прототипов (RuntimeProtoError, UserProtoError, UserError), создаёт из них экземпляры ошибок и оборачивает ошибки, переданные из других слоёв системы (ErrorWrapper)")
Rel(app, wire_errors, "Может использовать фабрики по умолчанию: опции ошибок (InitErrors), Handler (InitErrorHandler)")
Rel(wire_errors, errors, "Регистрирует опции создания ошибок: ID для system, ID и стек вызовов (при HasCaller) для internal (Hint)")

Rel(app, app_error_handler, "Передаёт ошибки (system и internal — с их персональным ID)")
Rel(app_error_handler, errors, "Реализует интерфейс Handler, определяет итоговый вид ошибки (Kind)")
Rel(wire_errors, app_error_handler, "Может предоставить реализацию по умолчанию (InitErrorHandler): логирование через mrlog")
Rel(app_error_handler, observability, "Логирует, трассирует ошибки и отправляет информацию о них")
Rel(app, user, "Сообщает пользователю об ошибках с их персональным ID")

Rel(developer, observability, "Анализирует ошибки")
Rel(developer, app, "Устраняет проблемы, на основе анализа создаёт новые типы ошибок")

Rel(user, developer, "Сообщает о проблеме через внешние каналы, указывая персональный ID ошибки")

@enduml
